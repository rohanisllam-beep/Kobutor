# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WebRTC STUN/TURN Network Relay Configurations (Optional custom overrides):
# METERED_API_KEY: Optional API key from metered.ca for dynamic production TURN credentials
# METERED_DOMAIN: Optional custom domain (defaults to openrelay.metered.ca)
# TURN_URLS: Optional custom TURN server URLs (comma-separated, e.g. turn:coturn.example.com:3478,turns:coturn.example.com:443)
# TURN_USERNAME: Optional custom TURN username
# TURN_CREDENTIAL: Optional custom TURN password/secret
METERED_API_KEY=""
METERED_DOMAIN=""
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
